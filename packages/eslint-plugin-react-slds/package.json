{
  "name": "@salesforce-ux/eslint-plugin-react-slds",
  "version": "1.0.0-alpha.0",
  "type": "module",
  "main": "build/index.mjs",
  "module": "build/index.mjs",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs"
    },
    "./config": "./eslint.config.mjs"
  },
  "files": [
    "build/**",
    "README.md",
    "eslint.config.mjs"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "gulp build",
    "dev": "gulp dev",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" npx jest",
    "prepublishOnly": "clean-pkg-json"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "lightning-design-system",
    "slds2"
  ],
  "author": "UXF Tooling Team",
  "license": "ISC",
  "description": "ESLint plugin for SLDS checks in React applications",
  "dependencies": {
    "@eslint-react/kit": "5.18.6",
    "@eslint/css-tree": "^3.6.5",
    "@salesforce-ux/eslint-plugin-slds": "1.3.0-internal-beta.8",
    "@salesforce-ux/sds-metadata": "2.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "chroma-js": "^3.2.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "postcss-styled-syntax": "^0.7.2"
  },
  "peerDependencies": {
    "eslint": "^10.3.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "devDependencies": {
    "@types/chroma-js": "^2.4.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.19",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salesforce-ux/slds-linter.git"
  },
  "bugs": {
    "url": "https://github.com/salesforce-ux/slds-linter/issues"
  },
  "homepage": "https://github.com/salesforce-ux/slds-linter#slds-linter",
  "publishConfig": {
    "tag": "alpha"
