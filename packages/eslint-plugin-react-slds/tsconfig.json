{
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["./src/types", "./node_modules/@types", "../../node_modules/@types"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["build", "node_modules"]
}
